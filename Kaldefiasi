            >
            <input
              type="number"
              id="luasTanah2"
              placeholder="0"
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <!-- Input Tambahan Khusus B (Bangunan) -->
          <div
            id="containerBangunan2"
            class="hidden space-y-3 pt-2 border-t border-dashed border-slate-200 bg-amber-50/50 p-3 rounded-lg"
          >
            <p class="text-xs font-semibold text-amber-800">
              Potongan Bangunan:
            </p>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1"
                >Luas Bangunan (m²)</label
              >
              <input
                type="number"
                id="luasBangunan2"
                placeholder="0"
                class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
              />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1"
                >Nilai Bangunan / m² (Rp)</label
              >
              <input
                type="text"
                id="nilaiBangunan2"
                placeholder="0"
                oninput="formatRupiahInput(this)"
                class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
              />
            </div>
          </div>
        </div>

        <!-- Kolom Harga 3 -->
        <div
          class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-2"
          >
            <h2 class="font-semibold text-slate-800 text-lg">Sampel Harga 3</h2>
            <span
              class="text-xs bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded-full font-medium"
              >Data 3</span
            >
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1"
              >Jenis Objek Pembanding</label
            >
            <select
              id="tipe3"
              onchange="toggleBangunanInput(3)"
              class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium"
            >
              <option value="TK">TK (Tanah Kosong)</option>
              <option value="B">B (Bangunan)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1"
              >Harga Transaksi/Penawaran (Rp)</label
            >
            <input
              type="text"
              id="harga3"
              placeholder="0"
              oninput="formatRupiahInput(this)"
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-semibold text-slate-900"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1"
              >Luas Tanah (m²)</label
            >
            <input
              type="number"
              id="luasTanah3"
              placeholder="0"
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <!-- Input Tambahan Khusus B (Bangunan) -->
          <div
            id="containerBangunan3"
            class="hidden space-y-3 pt-2 border-t border-dashed border-slate-200 bg-amber-50/50 p-3 rounded-lg"
          >
            <p class="text-xs font-semibold text-amber-800">
              Potongan Bangunan:
            </p>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1"
                >Luas Bangunan (m²)</label
              >
              <input
                type="number"
                id="luasBangunan3"
                placeholder="0"
                class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
              />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1"
                >Nilai Bangunan / m² (Rp)</label
              >
              <input
                type="text"
                id="nilaiBangunan3"
                placeholder="0"
                oninput="formatRupiahInput(this)"
                class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Parameter Luas Tanah Objek -->
      <div
        class="bg-indigo-900 text-white p-5 rounded-xl shadow-sm flex flex-col md:flex-row items-center justify-between gap-4"
      >
        <div>
          <h3 class="font-semibold text-base">Luas Tanah Objek Yang Dinilai</h3>
          <p class="text-xs text-indigo-200">
            Luas tanah ini digunakan untuk menghitung Total Nilai Tanah Objek.
          </p>
        </div>
        <div class="w-full md:w-auto flex items-center gap-2">
          <input
            type="number"
            id="luasObjek"
            placeholder="Contoh: 100"
            class="w-full md:w-48 bg-indigo-800 border border-indigo-700 text-white placeholder-indigo-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
          />
          <span class="text-sm font-medium">m²</span>
        </div>
      </div>

      <!-- Tombol Hitung GG -->
      <div class="text-center pt-2">
        <button
          onclick="hitungGG()"
          class="w-full md:w-auto px-12 py-3.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold rounded-xl shadow-lg hover:shadow-indigo-500/20 transition duration-200 text-lg"
        >
          Hitung Nilai Tanah (gg)
        </button>
      </div>

      <!-- Hasil Kalkulasi -->
      <div
        id="hasilSection"
        class="hidden bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-6"
      >
        <h2
          class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-3"
        >
          Hasil Kalkulasi Nilai Tanah
        </h2>

        <!-- Ringkasan Kartu -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
            <span class="text-xs text-slate-500 font-medium"
              >Rata-Rata Nilai Tanah / m²</span
            >
            <p
              id="resNilaiPerMeter"
              class="text-xl font-bold text-indigo-600 mt-1"
            >
              Rp 0
            </p>
          </div>

          <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
            <span class="text-xs text-slate-500 font-medium"
              >Total Nilai Tanah Objek</span
            >
            <p
              id="resNilaiTotal"
              class="text-xl font-bold text-emerald-600 mt-1"
            >
              Rp 0
            </p>
          </div>

          <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
            <span class="text-xs text-slate-500 font-medium"
              >Standar Deviasi / % Deviasi</span
            >
            <p id="resDeviasi" class="text-xl font-bold text-slate-800 mt-1">
              Rp 0 (0%)
            </p>
            <span
              id="resStatusDeviasi"
              class="text-xs font-semibold px-2 py-0.5 rounded mt-2 inline-block"
            ></span>
          </div>
        </div>

        <!-- Rincian Nilai Tanah per Sampel -->
        <div class="border-t border-slate-100 pt-4">
          <h3 class="text-sm font-semibold text-slate-700 mb-3">
            Breakdown Ekstraksi Nilai Tanah / m² per Sampel:
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
              <span class="text-xs text-slate-500 block"
                >Sampel 1 (<span id="tipeSampel1"></span>)</span
              >
              <span id="detailSampel1" class="font-semibold text-slate-800"
                >Rp 0 / m²</span
              >
            </div>
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
              <span class="text-xs text-slate-500 block"
                >Sampel 2 (<span id="tipeSampel2"></span>)</span
              >
              <span id="detailSampel2" class="font-semibold text-slate-800"
                >Rp 0 / m²</span
              >
            </div>
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
              <span class="text-xs text-slate-500 block"
                >Sampel 3 (<span id="tipeSampel3"></span>)</span
              >
              <span id="detailSampel3" class="font-semibold text-slate-800"
                >Rp 0 / m²</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // --- FITUR PROTEKSI / ANTI INSPECT & COPY ---
      // 1. Matikan Klik Kanan
      document.addEventListener('contextmenu', function (e) {
        e.preventDefault()
      })

      // 2. Matikan Shortcut Inspect (F12, Ctrl+U, Ctrl+Shift+I, dll)
      document.addEventListener('keydown', function (e) {
        if (
          e.key === 'F12' ||
          e.keyCode === 123 ||
          ((e.ctrlKey || e.metaKey) &&
            ((e.shiftKey &&
              (e.key === 'I' ||
                e.key === 'i' ||
                e.key === 'J' ||
                e.key === 'j' ||
                e.key === 'C' ||
                e.key === 'c')) ||
              e.key === 'U' ||
              e.key === 'u' ||
              e.key === 'S' ||
              e.key === 's'))
        ) {
          e.preventDefault()
          return false
        }
      })

      // 3. Matikan Drag Teks
      document.addEventListener('dragstart', function (e) {
        e.preventDefault()
      })

      // --- LOGIKA KALKULATOR ---
      function formatRupiahInput(input) {
        let value = input.value.replace(/\D/g, '')
        if (value) {
          input.value = new Intl.NumberFormat('id-ID').format(value)
        } else {
          input.value = ''
        }
      }

      function cleanNumber(val) {
        if (!val) return 0
        return (
          parseFloat(val.toString().replace(/\./g, '').replace(/,/g, '.')) || 0
        )
      }

      function toggleBangunanInput(index) {
        const tipe = document.getElementById(`tipe${index}`).value
        const container = document.getElementById(`containerBangunan${index}`)
        if (tipe === 'B') {
          container.classList.remove('hidden')
        } else {
          container.classList.add('hidden')
        }
      }

      function formatRupiah(num) {
        return 'Rp ' + Math.round(num).toLocaleString('id-ID')
      }

      function hitungGG() {
        const nilaiPerMeterArr = []

        for (let i = 1; i <= 3; i++) {
          const tipe = document.getElementById(`tipe${i}`).value
          const hargaTotal = cleanNumber(
            document.getElementById(`harga${i}`).value,
          )
          const luasTanah =
            parseFloat(document.getElementById(`luasTanah${i}`).value) || 0

          if (hargaTotal <= 0 || luasTanah <= 0) {
            alert(`Mohon lengkapi Harga dan Luas Tanah untuk Sampel ${i}`)
            return
          }

          let nilaiTanahOnly = hargaTotal

          if (tipe === 'B') {
            const luasBangunan =
              parseFloat(document.getElementById(`luasBangunan${i}`).value) || 0
            const nilaiBangunanPerMeter = cleanNumber(
              document.getElementById(`nilaiBangunan${i}`).value,
            )
            const totalNilaiBangunan = luasBangunan * nilaiBangunanPerMeter

            if (totalNilaiBangunan >= hargaTotal) {
              alert(
                `Nilai bangunan pada Sampel ${i} melebihi atau sama dengan harga total properti!`,
              )
              return
            }

            nilaiTanahOnly = hargaTotal - totalNilaiBangunan
          }

          const nilaiPerMeter = nilaiTanahOnly / luasTanah
          nilaiPerMeterArr.push(nilaiPerMeter)

          document.getElementById(`tipeSampel${i}`).innerText =
            tipe === 'TK' ? 'Tanah Kosong' : 'Bangunan'
          document.getElementById(`detailSampel${i}`).innerText =
            `${formatRupiah(nilaiPerMeter)} / m²`
        }

        const avgNilaiPerMeter = nilaiPerMeterArr.reduce((a, b) => a + b, 0) / 3
        const luasObjek =
          parseFloat(document.getElementById('luasObjek').value) || 0
        const totalNilaiObjek = avgNilaiPerMeter * luasObjek

        const variance =
          nilaiPerMeterArr.reduce(
            (acc, val) => acc + Math.pow(val - avgNilaiPerMeter, 2),
            0,
          ) / 2
        const stdDeviasi = Math.sqrt(variance)
        const persenDeviasi = (stdDeviasi / avgNilaiPerMeter) * 100

        document.getElementById('resNilaiPerMeter').innerText =
          formatRupiah(avgNilaiPerMeter) + ' / m²'

        if (luasObjek > 0) {
          document.getElementById('resNilaiTotal').innerText =
            formatRupiah(totalNilaiObjek)
        } else {
          document.getElementById('resNilaiTotal').innerText = 'Isi luas objek'
        }

        document.getElementById('resDeviasi').innerText =
          `${formatRupiah(stdDeviasi)} (${persenDeviasi.toFixed(2)}%)`

        const statusDev = document.getElementById('resStatusDeviasi')
        if (persenDeviasi <= 15) {
          statusDev.className =
            'text-xs font-semibold px-2.5 py-1 rounded-full mt-2 inline-block bg-emerald-100 text-emerald-800'
          statusDev.innerText = 'Presisi Data Bagus (≤ 15%)'
        } else {
          statusDev.className =
            'text-xs font-semibold px-2.5 py-1 rounded-full mt-2 inline-block bg-rose-100 text-rose-800'
          statusDev.innerText = 'Deviasi Tinggi (> 15%) - Periksa Variasi Data'
        }

        document.getElementById('hasilSection').classList.remove('hidden')
        document
          .getElementById('hasilSection')
          .scrollIntoView({ behavior: 'smooth' })
      }
    </script>
