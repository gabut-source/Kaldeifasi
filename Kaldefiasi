<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kalkulator Nilai Tanah</title>
    <!-- Tailwind CSS CDN -->
    <script src="[https://cdn.tailwindcss.com](https://cdn.tailwindcss.com)"></script>
    <link
      href="[https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap](https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap)"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Inter', sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 min-h-screen p-4 md:p-8 select-none">
    <div class="max-w-6xl mx-auto space-y-6 pt-4">
      <!-- Form Input Data -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Kolom Harga 1 -->
        <div
          class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-2"
          >
            <h2 class="font-semibold text-slate-800 text-lg">Sampel Harga 1</h2>
            <span
              class="text-xs bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded-full font-medium"
              >Data 1</span
            >
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1"
              >Jenis Objek Pembanding</label
            >
            <select
              id="tipe1"
              onchange="toggleBangunanInput(1)"
              class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium"
            >
              <option value="TK">TK (Tanah Kosong)</option>
              <option value="B">B (Bangunan)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1"
              >Harga Transaksi/Penawaran (Rp)</label
            >
            <input
              type="text"
              id="harga1"
              placeholder="0"
              oninput="formatRupiahInput(this)"
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-semibold text-slate-900"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1"
              >Luas Tanah (m²)</label
            >
            <input
              type="number"
              id="luasTanah1"
              placeholder="0"
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <!-- Input Tambahan Khusus B (Bangunan) -->
          <div
            id="containerBangunan1"
            class="hidden space-y-3 pt-2 border-t border-dashed border-slate-200 bg-amber-50/50 p-3 rounded-lg"
          >
            <p class="text-xs font-semibold text-amber-800">
              Potongan Bangunan:
            </p>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1"
                >Luas Bangunan (m²)</label
              >
              <input
                type="number"
                id="luasBangunan1"
                placeholder="0"
                class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
              />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1"
                >Nilai Bangunan / m² (Rp)</label
              >
              <input
                type="text"
                id="nilaiBangunan1"
                placeholder="0"
                oninput="formatRupiahInput(this)"
                class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
              />
            </div>
          </div>
        </div>

        <!-- Kolom Harga 2 -->
        <div
          class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-2"
          >
            <h2 class="font-semibold text-slate-800 text-lg">Sampel Harga 2</h2>
            <span
              class="text-xs bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded-full font-medium"
